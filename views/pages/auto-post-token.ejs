<p><%= t('callback.body1') %></p>
<p><%= t('callback.body2') %></p>

<form id="callback-form" method="POST" action="<%= callbackUrl %>">
  <input type="hidden" name="token" value="<%= token %>" />
  <button
    id="callback-submit"
    type="submit"
    class="primary-action-button inline-block px-6 py-3 text-white rounded-lg hover:opacity-90 transition duration-300"
  >
    <%= t('callback.continue') %>
  </button>
</form>

<script src="<%= withBasePath('/scripts/auto-post-token.js') %>"></script>
